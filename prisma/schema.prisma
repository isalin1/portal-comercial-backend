generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  ADMIN
  CLIENTE
  EMPRESARIO
}

enum DocType {
  RUC
  DNI
}

model DatUser {
  id        Int      @id @default(autoincrement())
  firstName String   @map("nombre")
  lastName  String   @map("apellidos")
  email     String   @unique
  phone     String   @map("tel_user")
  userType  UserType @map("tipo_user")

  user User?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dat_users")
}

model User {
  id         Int     @id @default(autoincrement())
  password   String  @map("password_hash")
  isActive   Boolean @default(true) @map("estado")

  datUserId Int     @unique @map("dat_user_id")
  datUser   DatUser @relation(fields: [datUserId], references: [id], onDelete: Cascade)

  businesses Business[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  provinces Province[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("departments")
}

model Province {
  id           Int        @id @default(autoincrement())
  name         String
  departmentId Int        @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id])
  districts    District[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([departmentId, name])
  @@map("provinces")
}

model District {
  id         Int       @id @default(autoincrement())
  name       String
  provinceId Int       @map("province_id")
  province   Province  @relation(fields: [provinceId], references: [id])
  addresses  Address[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([provinceId, name])
  @@map("districts")
}

model Rubro {
  id         Int        @id @default(autoincrement())
  name       String     @unique
  categories Category[]
  businesses Business[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("rubros")
}

model Category {
  id      Int    @id @default(autoincrement())
  name    String
  rubroId Int    @map("rubro_id")
  rubro   Rubro  @relation(fields: [rubroId], references: [id])
  items   Item[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([rubroId, name])
  @@map("categories")
}

model Business {
  id             Int    @id @default(autoincrement())
  legalName      String @map("razon_social")
  commercialName String @map("nombre_comercial")
  numDoc         String  @unique @map("num_doc")
  docType        DocType @map("tipo_doc")

  rubroId Int   @map("rubro_id")
  rubro   Rubro @relation(fields: [rubroId], references: [id])

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id])

  pointSales PointSale[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("businesses")
}

model Address {
  id          Int     @id @default(autoincrement())
  urbanZone   String? @map("urb_zona")
  street      String  @map("direccion")
  reference   String? @map("referencia")

  districtId Int      @map("district_id")
  district   District @relation(fields: [districtId], references: [id])

  pointSale PointSale?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("addresses")
}

model PointSale {
  id    Int    @id @default(autoincrement())
  name  String
  phone String @map("tel_pto_vta")

  businessId Int      @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  addressId Int     @unique @map("direccion_id")
  address   Address @relation(fields: [addressId], references: [id])

  items Item[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("point_sales")
}

model Item {
  id        Int     @id @default(autoincrement())
  name      String
  imageUrl  String? @map("imagen_url")
  isActive  Boolean @default(true) @map("estado")

  pointSaleId Int       @map("punto_venta_id")
  pointSale   PointSale @relation(fields: [pointSaleId], references: [id], onDelete: Cascade)

  categoryId Int      @map("categoria_id")
  category   Category @relation(fields: [categoryId], references: [id])

  descriptions ItemDescription[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("items")
}

model ItemDescription {
  id          Int     @id @default(autoincrement())
  description String  @map("descripcion")
  price       Decimal @db.Decimal(10, 2) @map("precio")

  itemId Int  @map("item_id")
  item   Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("descriptions")
}
